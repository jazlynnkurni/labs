# Agent Arena configuration. Copy to .env.local and fill in only what you use.
# Never commit .env.local. Values here are read by the server only and are
# never sent to the browser or written to logs.

# Where experiments, workspaces, logs and screenshots are stored.
# Defaults to ~/.agent-arena (outside this repository on purpose).
# ARENA_DATA_DIR=

# Show the scripted development fixture in the composer (not an AI agent).
# ARENA_DEV_FIXTURES=1

# Docker image used by the Docker runner for evaluation and previews.
# ARENA_DOCKER_IMAGE=node:24-bookworm-slim

# Claude Code: leave empty to use your `claude auth login` session.
# ANTHROPIC_API_KEY=
# CLAUDE_BIN=/path/to/claude

# Codex CLI: leave empty to use your `codex login` session.
# CODEX_API_KEY=
# CODEX_BIN=/path/to/codex

# Cursor Agent CLI: leave empty to use your `agent login` session.
# CURSOR_API_KEY=
# CURSOR_AGENT_BIN=/path/to/agent

# BLACKBOX CLI: configured with `blackbox configure`.
# BLACKBOX_API_KEY=
# BLACKBOX_BIN=/path/to/blackbox

# Devin API v3 (service user key and organization id).
# DEVIN_API_KEY=
# DEVIN_ORG_ID=
# DEVIN_API_BASE=https://api.devin.ai/v3

# Design QA (/qa): the Jev decision API at thejevai.com. Put your own key here
# yourself; the server reads it, never logs it, never sends it to the browser.
# JEV_API_KEY=
# JEV_MODEL=typesafe/jev-1.13
# JEV_API_BASE_URL=https://thejevai.com
